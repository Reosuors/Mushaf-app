<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:gravity="center"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="آية اليوم" android:textColor="#E8CC7A" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="مصحف" android:textColor="#9A8868" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_ayah_text" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="إِنَّ مَعَ الْعُسْرِ يُسْرًا"
        android:textColor="#F0E8D8" android:textDirection="rtl" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_ayah_reference" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="الشرح • الآية 6" android:textColor="#C9A84C" android:textSize="12sp" />
    <TextView android:id="@+id/widget_ayah_city" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="5dp" android:text="مصحف" android:textColor="#4A4030" android:textSize="10sp" />
</LinearLayout>
