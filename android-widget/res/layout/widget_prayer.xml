<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background" android:textDirection="locale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:id="@+id/widget_prayer_title" android:text="أوقات الصلاة" android:textColor="#E8CC7A" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_prayer_city" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الموقع الحالي" android:textColor="#9A8868" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginBottom="3dp" android:background="#4A3D1D" />
    <LinearLayout android:id="@+id/prayer_row_fajr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_name_fajr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الفجر" android:textColor="#F0E8D8" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/prayer_time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E8CC7A" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prayer_row_dhuhr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_name_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الظهر" android:textColor="#F0E8D8" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/prayer_time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E8CC7A" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prayer_row_asr" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_name_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العصر" android:textColor="#F0E8D8" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/prayer_time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E8CC7A" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prayer_row_maghrib" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_name_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="المغرب" android:textColor="#F0E8D8" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/prayer_time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E8CC7A" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/prayer_row_isha" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_name_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العشاء" android:textColor="#F0E8D8" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/prayer_time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#E8CC7A" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
