{
  "appId": "com.ahmad.mushaf",
  "productName": "Mushaf",
  "copyright": "Mushaf",
  "directories": {
    "output": "out",
    "buildResources": "electron"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "package.json"
  ],
  "asar": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "electron/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "artifactName": "Mushaf_Setup.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      }
    ],
    "icon": "electron/icon.png",
    "category": "public.app-category.lifestyle",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "artifactName": "Mushaf.${ext}"
  }
}